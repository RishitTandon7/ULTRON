import tkinter as tk
import pyaudio
import numpy as np
import time

# Set up the Tkinter window
root = tk.Tk()
root.title("Voice Reactive Glowing Line")

# Make the window full-screen
root.attributes('-fullscreen', True)

# Make the window background fully transparent (Windows-specific)
root.attributes("-transparentcolor", "black")

# Remove window borders
root.overrideredirect(True)

# Set up the PyAudio for capturing microphone input
p = pyaudio.PyAudio()

# Define microphone stream
stream = p.open(format=pyaudio.paInt16,
                channels=1,
                rate=44100,
                input=True,
                frames_per_buffer=1024)

# Function to calculate the intensity of the microphone input
def get_volume():
    data = np.frombuffer(stream.read(1024), dtype=np.int16)
    volume = np.linalg.norm(data) / 1024  # Calculate amplitude
    return min(volume * 10, 1)  # Scale volume to a maximum of 1 for intensity

# Function to convert a hex color to RGB
def hex_to_rgb(hex_color):
    hex_color = hex_color.lstrip('#')
    return tuple(int(hex_color[i:i+2], 16) for i in (0, 2, 4))

# Function to convert RGB to hex
def rgb_to_hex(r, g, b):
    return f"#{r:02x}{g:02x}{b:02x}"

# Function to smoothly interpolate between two colors
def interpolate_color(color1, color2, t):
    """Interpolate between two colors based on t (0 to 1)."""
    r1, g1, b1 = hex_to_rgb(color1)
    r2, g2, b2 = hex_to_rgb(color2)
    r = int(r1 + (r2 - r1) * t)
    g = int(g1 + (g2 - g1) * t)
    b = int(b1 + (b2 - b1) * t)
    return rgb_to_hex(r, g, b)

# Function to generate the next color in the cycle
def next_color():
    color_list = ['#FF77B7', '#4335A7', '#FF7F3E', '#C4E1F6', '#500073', '#2A004E']
    global current_color_index
    current_color_index = (current_color_index + 1) % len(color_list)
    return color_list[current_color_index]

# Function to animate the glowing line with fluctuating X position and smooth color transition
def update_glow():
    global glow_x_offset, current_color, target_color, color_transition_step

    # Get the volume intensity from the microphone
    glow_intensity = get_volume()

    # Fluctuate the X position based on the intensity (vibration effect)
    glow_x_offset = (np.sin(glow_intensity * np.pi * 2) * 100)  # Vibration effect on X axis

    # Fluctuate the radius (thickness) based on intensity
    glow_radius = 1 + glow_intensity * 5  # Radius will fluctuate between 5 and 20 based on volume

    # Get the current screen width and height (ensure the size is updated)
    screen_width = root.winfo_screenwidth()
    screen_height = root.winfo_screenheight()

    # Update the position of the line to make it vibrate on the X-axis across the full screen width
    glow_line_y_offset = screen_height - 50  # Adjust this value to move the line down vertically
    canvas.coords(glow_line,
                  glow_x_offset, glow_line_y_offset,  # Move the line further down
                  screen_width - glow_x_offset, glow_line_y_offset + glow_radius)  # Adjust thickness here

    # Interpolate the color
    t = color_transition_step / color_transition_duration
    new_color = interpolate_color(current_color, target_color, t)
    canvas.itemconfig(glow_line, fill=new_color)

    # Update the transition step
    color_transition_step += 1
    if color_transition_step > color_transition_duration:
        current_color = target_color
        target_color = next_color()
        color_transition_step = 0

    # Recursively call update_glow every 50ms
    root.after(50, update_glow)

# Function to change the color every second
def change_color():
    global target_color, current_color
    target_color = next_color()  # Set the new target color

# Initialize the color transition parameters
current_color_index = 0  # Initialize the current color index
current_color = "#FFFDF0"  # Initial color
target_color = next_color()  # Next color
color_transition_step = 0  # Initialize color transition step
color_transition_duration = 30  # Duration of the color transition in steps

# Set the color to change every second
root.after(1000, change_color)

# Create the canvas to draw the glowing line effect
canvas = tk.Canvas(root, width=root.winfo_screenwidth(), height=root.winfo_screenheight(), bg="black", highlightthickness=0)
canvas.pack()

# Update the canvas to make sure the correct screen size is applied
root.update_idletasks()

# Create the glowing line for the effect (line that spans the full width at the bottom)
glow_line = canvas.create_rectangle(0, root.winfo_screenheight() - 10, root.winfo_screenwidth(), root.winfo_screenheight() - 5, fill="blue", outline="")

# Start the animation
update_glow()

# Start the Tkinter main loop
root.mainloop()
